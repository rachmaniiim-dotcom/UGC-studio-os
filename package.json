{
  "name": "ugc-production-os",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "postinstall": "node apps/desktop/scripts/install-electron.mjs && node scripts/install-git-hooks.mjs",
    "build": "tsc -b packages/core packages/test-fixtures apps/desktop && node apps/desktop/scripts/copy-static.mjs",
    "typecheck": "pnpm build && tsc -p tsconfig.tests.json",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "pnpm build && pnpm --filter @ugc/desktop test:e2e",
    "check:secrets": "node scripts/check-no-secrets.mjs",
    "security-check": "node apps/desktop/scripts/security-check.mjs --scan ."
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "6.0.2",
    "vitest": "5.0.5"
  }
}
